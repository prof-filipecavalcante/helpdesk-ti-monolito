# Copie para .env e ajuste. O arquivo .env nunca deve ir para o GitHub.

# Segredo para assinar os tokens de login (mínimo 32 caracteres).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazio, um segredo aleatório é criado a cada início.
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026

# 0 = desliga a documentação /docs (recomendado em produção)
DOCS=1
